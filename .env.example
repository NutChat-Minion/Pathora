# Neon Postgres connection string (use the pooled one on Vercel)
DATABASE_URL=
# Long random string used by Payload to sign sessions (openssl rand -hex 32)
PAYLOAD_SECRET=
# Public origin of the site, e.g. https://pathora.vercel.app
NEXT_PUBLIC_SITE_URL=
# Vercel Blob read/write token (enables cloud file storage; empty = local disk)
BLOB_READ_WRITE_TOKEN=
# Google Gemini API key (free tier) for AI moderation + research (server only). Takes priority over Anthropic.
GEMINI_API_KEY=
# Optional model overrides (defaults: gemini-3.5-flash / gemini-3.5-flash-lite)
GEMINI_RESEARCH_MODEL=
GEMINI_MODERATION_MODEL=
# Tavily API key (free tier, server only). With GEMINI_API_KEY, research uses Tavily search + Gemini extraction (no Google Search grounding; ~5 credits/topic).
TAVILY_API_KEY=
# Anthropic API key, used only when GEMINI_API_KEY is not set (server only)
ANTHROPIC_API_KEY=
# Stripe secret key (server only)
STRIPE_SECRET_KEY=
# Stripe webhook signing secret for /webhook endpoint
STRIPE_WEBHOOK_SECRET=
# Stripe publishable key (optional, safe for browser)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Shared secret Vercel Cron sends as Authorization: Bearer for cron routes
CRON_SECRET=
# Google OAuth client for "Continue with Google" (server only). Redirect URI to register:
# <site>/pathora-api/auth/google/callback. Leave empty to hide the button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
